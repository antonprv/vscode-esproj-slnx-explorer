{
  "name": "slnx-explorer",
  "displayName": "SLNX Solution Explorer",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:**/*.slnx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "slnxExplorerContainer",
          "title": "%view.container.title%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "slnxExplorerContainer": [
        {
          "id": "slnxExplorer",
          "name": "%view.solution.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "slnxExplorer",
        "contents": "%viewsWelcome.noSolution%"
      }
    ],
    "commands": [
      {
        "command": "slnxExplorer.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "slnxExplorer.openSolution",
        "title": "%command.openSolution.title%"
      },
      {
        "command": "slnxExplorer.openFile",
        "title": "%command.openFile.title%"
      },
      {
        "command": "slnxExplorer.revealInOs",
        "title": "%command.revealInOs.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "slnxExplorer.refresh",
          "when": "view == slnxExplorer",
          "group": "navigation"
        },
        {
          "command": "slnxExplorer.openSolution",
          "when": "view == slnxExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "slnxExplorer.revealInOs",
          "when": "view == slnxExplorer"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.6"
  }
}
